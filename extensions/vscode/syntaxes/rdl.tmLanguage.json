{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RDL",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rdl",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rdl",
          "match": "\\b(if|else|elseif|for|in|while|return|import|struct)\\b"
        },
        {
          "name": "keyword.other.rdl",
          "match": "\\b(let|func)\\b"
        },
        {
          "name": "constant.language.rdl",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "support.type.rdl",
          "match": "\\b(Number|String|Boolean|Object|Nil|Undefined|Function|Range|Array|Struct)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.rdl",
          "match": "\\b(print|println|input|now|sleep|read_file|write_file|open_file|read_line|read_all|close|has_next|length|upper|lower|split|push|pop|to_string)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rdl",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.rdl",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.rdl",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.dollar.rdl",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_$]*"
        },
        {
          "name": "variable.other.rdl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_$]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rdl",
          "match": "(\\+|\\-|\\*|/|==|=|!=|>=|<=|>|<|&&|\\|\\||\\.\\.|\\.|:|::|!)"
        }
      ]
    }
  ],
  "scopeName": "source.rdl"
}
