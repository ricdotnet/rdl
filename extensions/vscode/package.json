{
  "name": "rdl-vscode",
  "displayName": "RDL Language Support",
  "description": "Language support for RDL including syntax highlighting and formatting",
  "version": "0.1.0",
  "publisher": "rdl-org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/rdl"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:rdl"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rdl",
        "aliases": [
          "RDL",
          "rdl"
        ],
        "extensions": [
          ".rdl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rdl",
        "scopeName": "source.rdl",
        "path": "./syntaxes/rdl.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.2",
    "vscode-languageserver": "^8.0.2",
    "vscode-languageserver-textdocument": "^1.0.8"
  }
}
